{
  "id": null,
  "uid": "lever-decision",
  "title": "Decisão",
  "description": "Serviço de decisão do Lever (spec 001, seção 10): requisições, latência, stream e configuração por ambiente.",
  "tags": ["lever", "decision", "spec-001"],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "schemaVersion": 41,
  "version": 1,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "route",
        "label": "Rota",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(lever_decision_http_requests_total, route)",
        "query": {
          "qryType": 1,
          "query": "label_values(lever_decision_http_requests_total, route)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1,
        "options": [],
        "hide": 0
      },
      {
        "type": "query",
        "name": "environment_id",
        "label": "Ambiente",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(lever_decision_config_version, environment_id)",
        "query": {
          "qryType": 1,
          "query": "label_values(lever_decision_config_version, environment_id)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1,
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Tráfego",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Requisições por rota",
      "description": "Requisições por segundo, por rota e status (lever_decision_http_requests_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route, status_code) (rate(lever_decision_http_requests_total{route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{route}} {{status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Fração de erros 5xx por rota",
      "description": "Respostas 5xx dividido pelo total de cada rota. /v1/evaluate responde 500 enquanto a avaliação do autor não existir.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(lever_decision_http_requests_total{route=~\"$route\", status_code=~\"5..\"}[$__rate_interval])) / sum by (route) (rate(lever_decision_http_requests_total{route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 4,
      "title": "Latência",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Latência por rota (p50, p95, p99)",
      "description": "Percentis do histograma do servidor. A linha vermelha marca 20 ms (NFR-002). /v1/stream fica de fora: a duração registrada é a da conexão SSE inteira. O número oficial da NFR-002 é o do k6 (infra/k6).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(lever_decision_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/v1/stream\"}[$__rate_interval])))",
          "legendFormat": "p50 {{route}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(lever_decision_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/v1/stream\"}[$__rate_interval])))",
          "legendFormat": "p95 {{route}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(lever_decision_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/v1/stream\"}[$__rate_interval])))",
          "legendFormat": "p99 {{route}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "axisSoftMax": 0.025
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "p99 das rotas selecionadas",
      "description": "p99 de todas as rotas selecionadas juntas, sem /v1/stream. Verde abaixo de 20 ms (NFR-002).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(lever_decision_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/v1/stream\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "type": "heatmap",
      "id": 7,
      "title": "Distribuição da latência",
      "description": "Requisições por balde do histograma (lever_decision_http_request_duration_seconds), sem /v1/stream.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (le) (increase(lever_decision_http_request_duration_seconds_bucket{route=~\"$route\", route!=\"/v1/stream\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "range": true,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "fill": "dark-orange",
          "scale": "exponential",
          "exponent": 0.5,
          "steps": 64
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": false
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        }
