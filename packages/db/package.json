{
  "name": "@lever/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations and seed for the Lever Postgres database",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/cli/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env dist/cli/seed.js"
  },
  "dependencies": {
    "@lever/schemas": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lever/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
