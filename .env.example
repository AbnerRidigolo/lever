# Copy to .env (`cp .env.example .env`). Fictitious local values only: never commit real secrets.

# Postgres (infra/docker-compose.yml)
POSTGRES_USER=lever
POSTGRES_PASSWORD=lever-local-password
POSTGRES_DB=lever
POSTGRES_PORT=5432

# Used by packages/db (migrations and seed) and by the services.
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://lever:lever-local-password@localhost:5432/lever

# Prometheus and Grafana (http://localhost:9090 and http://localhost:3001)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-local-password

# Tempo (traces; Grafana reads them, the API is on http://localhost:3200)
TEMPO_PORT=3200
# OTLP over HTTP, where services/decision and apps/console send traces.
OTLP_HTTP_PORT=4318

# services/decision (http://localhost:4000)
DECISION_PORT=4000
LOG_LEVEL=info
# How long a validated API key is trusted before it is checked again.
API_KEY_CACHE_TTL_MS=30000
# Traces are exported over OTLP only when this is set. Uncomment to send them to Tempo
# (also read by apps/console).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# apps/console (http://localhost:3000)
# Any long random string; generate your own with: openssl rand -base64 32
AUTH_SECRET=fictitious-local-secret-change-me-0123456789
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=Lever <no-reply@lever.local>
# GitHub login appears only when both are set (needs an OAuth App in your account).
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Mailpit (magic links arrive at http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# apps/store (http://localhost:3002)
# Signs the fictitious account cookie of the store; any string of 16+ characters.
STORE_SESSION_SECRET=fictitious-store-session-secret-change-me
# "sdk" (the default in code) needs the decision service and LEVER_API_KEY below;
# "stub" runs the store alone, serving default values (store plan, D1).
LEVER_ADAPTER=stub
LEVER_DECISION_URL=http://localhost:4000
# A development key, created in the console or with
# pnpm --filter @lever/decision api-key:create -- --env development --name store
# LEVER_API_KEY=
# Values the stub serves to everyone, e.g. {"flags":{"new-banner":true}}
# LEVER_STUB_OVERRIDES=
