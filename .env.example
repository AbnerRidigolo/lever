# Copy to .env (`cp .env.example .env`). Fictitious local values only: never commit real secrets.

# Postgres (infra/docker-compose.yml)
POSTGRES_USER=lever
POSTGRES_PASSWORD=lever-local-password
POSTGRES_DB=lever
POSTGRES_PORT=5432

# Used by packages/db (migrations and seed) and by the services.
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://lever:lever-local-password@localhost:5432/lever

# Prometheus and Grafana (http://localhost:9090 and http://localhost:3001)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-local-password

# services/decision (http://localhost:4000)
DECISION_PORT=4000
LOG_LEVEL=info
# How long a validated API key is trusted before it is checked again.
API_KEY_CACHE_TTL_MS=30000
# Traces are exported over OTLP only when this is set (e.g. http://localhost:4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=
