{
  "name": "@lever/console",
  "version": "0.0.0",
  "private": true,
  "description": "Lever console: flags, experiments, segments, API keys and audit history",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev --port 3000",
    "start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "tsx --env-file-if-exists=../../.env e2e/prepare-db.ts && playwright test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@lever/db": "workspace:*",
    "@lever/schemas": "workspace:*",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "8.0.11",
    "pino": "10.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lever/config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "postgres": "3.4.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
