{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "AUTH_SECRET",
    "EMAIL_SERVER",
    "EMAIL_FROM",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "STORE_SESSION_SECRET",
    "LEVER_ADAPTER",
    "LEVER_DECISION_URL",
    "LEVER_API_KEY",
    "LEVER_STUB_OVERRIDES"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "db:migrate": {
      "dependsOn": ["build"],
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#lint:root": {},
    "test:e2e": {
      "dependsOn": ["build", "@lever/decision#build"],
      "cache": false
    }
  }
}
